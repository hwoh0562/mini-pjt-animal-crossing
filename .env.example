# 이 파일은 템플릿이며 저장소에 커밋된다. 실제 키를 절대 적지 말 것.
# 사용법:  cp .env.example .env   →  .env 에 값을 채운다 (.env 는 커밋 제외)

# ── Amazon Bedrock ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 임시 자격증명(ASIA... · STS/SSO)일 때만 채운다. 장기 키(AKIA...)면 비워 둔다.
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# ── Bedrock 모델 ───────────────────────────────────────────
# 추론 프로파일 접두사(us. / global.)에 따라 일일 토큰 쿼터 풀이 다르다.
# 한쪽이 ThrottlingException 이면 다른 쪽으로 바꿔 쓴다. 모델 자체는 동일하다.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── LangSmith 트레이싱 (활용 패턴 11) ──────────────────────
# 없어도 에이전트는 동작한다. 커스텀 trace 필드는 이것과 무관하게 채워진다.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mini-pjt-animal-crossing
